<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Veda Infinity School</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
</head>
<body class="app-body">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <img src="~/images/veda-logo-sm.png" alt="Logo" />
            <div>
                <span>VEDA INFINITY</span>
                <small>School Portfolio</small>
            </div>
        </div>
        <nav class="sidebar-menu">
            <a class="nav-link @(ViewData["Menu"] as string == "dashboard" ? "active" : "")" asp-page="/Dashboard"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <div class="menu-group @(ViewData["Menu"] as string == "students" ? "open" : "")">
                <a class="nav-link parent-link" href="javascript:void(0)"><i class="bi bi-people-fill"></i> Students <i class="bi bi-chevron-down chevron"></i></a>
                <div class="submenu">
                    <a class="nav-link sub-link" asp-page="/StudentMaster"><i class="bi bi-list-ul"></i> Student Master</a>
                    <a class="nav-link sub-link" asp-page="/Portfolio" asp-route-mode="new"><i class="bi bi-person-plus"></i> Add New Student</a>
                </div>
            </div>
            <div class="menu-group">
                <a class="nav-link parent-link" href="javascript:void(0)"><i class="bi bi-person-badge"></i> Teachers <i class="bi bi-chevron-down chevron"></i></a>
                <div class="submenu">
                    <a class="nav-link sub-link" asp-page="/Teachers/Courses"><i class="bi bi-book"></i> Courses</a>
                    <a class="nav-link sub-link" asp-page="/Teachers/Index"><i class="bi bi-person-badge"></i> Teachers List</a>
                </div>
            </div>
            <a class="nav-link" asp-page="/Payment"><i class="bi bi-credit-card"></i> Payment</a>
            <div class="menu-group">
                <a class="nav-link parent-link" href="javascript:void(0)"><i class="bi bi-file-earmark-bar-graph"></i> Reports <i class="bi bi-chevron-down chevron"></i></a>
                <div class="submenu">
                    <a class="nav-link sub-link" asp-page="/Reports/Student"><i class="bi bi-people"></i> Student</a>
                    <a class="nav-link sub-link" asp-page="/Reports/Course"><i class="bi bi-book"></i> Course</a>
                    <a class="nav-link sub-link" asp-page="/Reports/Payment"><i class="bi bi-credit-card"></i> Payment</a>
                </div>
            </div>
            <a class="nav-link" asp-page="/Settings"><i class="bi bi-gear"></i> Settings</a>
            <div class="session-label">SESSION</div>
            <a class="nav-link" href="javascript:void(0)"><i class="bi bi-calendar3"></i> 2026-27 Active</a>
        </nav>
        <div class="sidebar-footer">
            <form method="post" asp-page="/Logout">
                <button type="submit" class="nav-link"><i class="bi bi-box-arrow-left"></i> Logout</button>
            </form>
        </div>
    </aside>
    <div class="main-content">
        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-sm d-lg-none border-0" onclick="document.getElementById('sidebar').classList.toggle('show')">
                    <i class="bi bi-list fs-4" style="color:#0a3d28"></i>
                </button>
                <h1 class="page-title-inline">@ViewData["Title"]</h1>
            </div>
            <div class="header-actions">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search for students, portfolios..." />
                </div>
                <button type="button" class="notif-btn" title="Notifications"><i class="bi bi-bell"></i><span class="badge-dot"></span></button>
                <div class="user-chip">
                    <div class="avatar">A</div>
                    <div class="d-none d-md-block">
                        <div style="font-size:.85rem;font-weight:600;color:#1a2e25;">@(User.Identity?.Name ?? "Admin")</div>
                        <div style="font-size:.7rem;color:#8aa399;">Administrator</div>
                    </div>
                </div>
            </div>
        </header>
        <div class="content-area">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
