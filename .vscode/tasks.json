{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build VedaInfinity.Web",
      "type": "process",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}\\src\\VedaInfinity.Web\\VedaInfinity.Web.csproj",
        "--configuration",
        "Debug",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
